          {
            "dataset": "S1_Remote_Monitoring",
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n    CONCAT(d.location, ' - ', d.machine_name) AS [Device],\n    CAST(100.0 * SUM(COALESCE(ds.good_read,0)) / NULLIF(SUM(COALESCE(ds.total_items,0)),0) AS decimal(6,2)) AS [Good Read %],\n    CAST(100.0 * SUM(COALESCE(ds.no_read,0)) / NULLIF(SUM(COALESCE(ds.total_items,0)),0) AS decimal(6,2)) AS [No Read %],\n    CAST(100.0 * SUM(COALESCE(ds.no_dimension,0)) / NULLIF(SUM(COALESCE(ds.total_items,0)),0) AS decimal(6,2)) AS [No Dimension %],\n    CAST(100.0 * SUM(COALESCE(ds.item_out_of_spec,0)) / NULLIF(SUM(COALESCE(ds.total_items,0)),0) AS decimal(6,2)) AS [Out of Spec %],\n    CAST(100.0 * SUM(COALESCE(ds.more_than_1_item,0)) / NULLIF(SUM(COALESCE(ds.total_items,0)),0) AS decimal(6,2)) AS [Multi-Item %],\n    CAST(100.0 * SUM(COALESCE(ds.no_weight,0)) / NULLIF(SUM(COALESCE(ds.total_items,0)),0) AS decimal(6,2)) AS [No Weight %],\n    CAST(100.0 * SUM(COALESCE(ds.hand_scanned,0)) / NULLIF(SUM(COALESCE(ds.total_items,0)),0) AS decimal(6,2)) AS [Hand Scanned %]\nFROM dbo.devices d\nLEFT JOIN dbo.device_statistics ds\n    ON ds.device_id = d.id\n   AND $__timeFilter(ds.ts_datetime)\nWHERE d.customer = '${Customer}'\nGROUP BY d.location, d.machine_name\nORDER BY d.location, d.machine_name;",
