            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  CONCAT(d.location, ' - ', d.machine_name)     AS [Device],\n  SUM(COALESCE(ds.total_items,0))               AS [Total Items],\n  SUM(COALESCE(ds.good_read,0))                 AS [Good Reads],\n  SUM(COALESCE(ds.no_read,0))                   AS [No Read],\n  SUM(COALESCE(ds.no_dimension,0))              AS [No Dimension],\n  SUM(COALESCE(ds.item_out_of_spec,0))          AS [Out of Spec],\n  SUM(COALESCE(ds.more_than_1_item,0))          AS [Multi-Item],\n  SUM(COALESCE(ds.no_weight,0))                 AS [No Weight],\n  SUM(COALESCE(ds.hand_scanned,0))              AS [Hand Scanned],\n  SUM(COALESCE(ds.data_sent,0))                 AS [Data Sent],\n  SUM(COALESCE(ds.not_sent,0))                  AS [Not Sent]\nFROM dbo.devices d\nLEFT JOIN dbo.device_statistics ds\n  ON ds.device_id = d.id\n  AND $__timeFilter(ds.ts_datetime)\nWHERE d.customer = '${Customer}'\nGROUP BY d.location, d.machine_name\nORDER BY d.location, d.machine_name;",
