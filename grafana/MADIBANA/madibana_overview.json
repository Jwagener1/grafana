            "rawQuery": true,
            "rawSql": "SELECT\n    CONCAT(d.location, ' - ', d.machine_name) AS [Device],\n    COALESCE(ls.status, 'unknown') AS [Status]\nFROM dbo.devices d\nLEFT JOIN (\n    SELECT x.device_id, x.status FROM (\n        SELECT ds.device_id, ds.status,\n               ROW_NUMBER() OVER (PARTITION BY ds.device_id ORDER BY ds.ts_datetime DESC) AS rn\n        FROM dbo.device_status ds\n    ) x WHERE x.rn = 1\n) ls ON ls.device_id = d.id\nWHERE d.customer = '${Customer}'\nORDER BY d.location, d.machine_name;",
