        "targets": [
          {
            "dataset": "S1_Remote_Monitoring",
            "datasource": {
              "type": "mssql",
              "uid": "PAAAEB8D7872B0C49"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH base AS (\r\n    SELECT\r\n        DATEADD(HOUR, 2, ds.ts_datetime) AS ts_local,\r\n        ds.total_items,\r\n        ds.good_read\r\n    FROM dbo.device_statistics ds\r\n    JOIN dbo.devices d\r\n        ON d.id = ds.device_id\r\n    WHERE d.customer = ${Customer:sqlstring}\r\n),\r\nbounds AS (\r\n    SELECT\r\n        CAST(DATEADD(HOUR, 2, GETDATE()) AS date) AS day_start,\r\n        DATEADD(DAY, 1, CAST(DATEADD(HOUR, 2, GETDATE()) AS date)) AS day_end,\r\n\r\n        DATEFROMPARTS(YEAR(DATEADD(HOUR, 2, GETDATE())), MONTH(DATEADD(HOUR, 2, GETDATE())), 1) AS month_start,\r\n        DATEADD(MONTH, 1, DATEFROMPARTS(YEAR(DATEADD(HOUR, 2, GETDATE())), MONTH(DATEADD(HOUR, 2, GETDATE())), 1)) AS month_end,\r\n\r\n        DATEFROMPARTS(YEAR(DATEADD(HOUR, 2, GETDATE())), 1, 1) AS year_start,\r\n        DATEADD(YEAR, 1, DATEFROMPARTS(YEAR(DATEADD(HOUR, 2, GETDATE())), 1, 1)) AS year_end\r\n)\r\nSELECT\r\n    -- Year\r\n    COALESCE(SUM(CASE WHEN b.ts_local >= bo.year_start AND b.ts_local < bo.year_end THEN b.total_items ELSE 0 END), 0)\r\n        AS year_total_parcels,\r\n    CAST(\r\n        COALESCE(\r\n            100.0 * SUM(CASE WHEN b.ts_local >= bo.year_start AND b.ts_local < bo.year_end THEN b.good_read ELSE 0 END)\r\n            / NULLIF(SUM(CASE WHEN b.ts_local >= bo.year_start AND b.ts_local < bo.year_end THEN b.total_items ELSE 0 END), 0),\r\n            0\r\n        ) AS decimal(6,2)\r\n    ) AS year_good_read_pct,\r\n\r\n    -- Month\r\n    COALESCE(SUM(CASE WHEN b.ts_local >= bo.month_start AND b.ts_local < bo.month_end THEN b.total_items ELSE 0 END), 0)\r\n        AS month_total_parcels,\r\n    CAST(\r\n        COALESCE(\r\n            100.0 * SUM(CASE WHEN b.ts_local >= bo.month_start AND b.ts_local < bo.month_end THEN b.good_read ELSE 0 END)\r\n            / NULLIF(SUM(CASE WHEN b.ts_local >= bo.month_start AND b.ts_local < bo.month_end THEN b.total_items ELSE 0 END), 0),\r\n            0\r\n        ) AS decimal(6,2)\r\n    ) AS month_good_read_pct,\r\n\r\n    -- Day\r\n    COALESCE(SUM(CASE WHEN b.ts_local >= bo.day_start AND b.ts_local < bo.day_end THEN b.total_items ELSE 0 END), 0)\r\n        AS day_total_parcels,\r\n    CAST(\r\n        COALESCE(\r\n            100.0 * SUM(CASE WHEN b.ts_local >= bo.day_start AND b.ts_local < bo.day_end THEN b.good_read ELSE 0 END)\r\n            / NULLIF(SUM(CASE WHEN b.ts_local >= bo.day_start AND b.ts_local < bo.day_end THEN b.total_items ELSE 0 END), 0),\r\n            0\r\n        ) AS decimal(6,2)\r\n    ) AS day_good_read_pct\r\nFROM base b\r\nCROSS JOIN bounds bo;\r\n",
            "refId": "A",
