            "rawQuery": true,
            "rawSql": "\nSELECT\n  d.customer AS [Customer],\n  CAST(DATEADD(HOUR,2,ds.ts_datetime) AS date) AS [Date],\n  CAST(COALESCE(100.0*SUM(ds.good_read)/NULLIF(SUM(ds.total_items),0),0) AS decimal(5,1)) AS [Good Read %]\nFROM dbo.device_statistics ds\nJOIN dbo.devices d ON d.id = ds.device_id\nWHERE ds.ts_datetime >= DATEADD(DAY,-7,GETUTCDATE())\nGROUP BY d.customer, CAST(DATEADD(HOUR,2,ds.ts_datetime) AS date)\nHAVING SUM(ds.total_items) > 0\nORDER BY d.customer, [Date];",
