          {
            "dataset": "S1_Remote_Monitoring",
            "datasource": {
              "type": "mssql",
              "uid": "PAAAEB8D7872B0C49"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH base AS (\n    SELECT\n        DATEADD(HOUR, 2, ds.ts_datetime) AS ts_local,\n        ds.total_items,\n        ds.good_read\n    FROM dbo.device_statistics ds\n),\nbounds AS (\n    SELECT\n        CAST(DATEADD(HOUR, 2, GETDATE()) AS date) AS day_start,\n        DATEADD(DAY, 1, CAST(DATEADD(HOUR, 2, GETDATE()) AS date)) AS day_end,\n        DATEFROMPARTS(YEAR(DATEADD(HOUR, 2, GETDATE())), MONTH(DATEADD(HOUR, 2, GETDATE())), 1) AS month_start,\n        DATEADD(MONTH, 1, DATEFROMPARTS(YEAR(DATEADD(HOUR, 2, GETDATE())), MONTH(DATEADD(HOUR, 2, GETDATE())), 1)) AS month_end,\n        DATEFROMPARTS(YEAR(DATEADD(HOUR, 2, GETDATE())), 1, 1) AS year_start,\n        DATEADD(YEAR, 1, DATEFROMPARTS(YEAR(DATEADD(HOUR, 2, GETDATE())), 1, 1)) AS year_end\n)\nSELECT\n    COALESCE(SUM(CASE WHEN b.ts_local >= bo.year_start  AND b.ts_local < bo.year_end  THEN b.total_items ELSE 0 END), 0) AS year_total_parcels,\n    CAST(COALESCE(100.0 * SUM(CASE WHEN b.ts_local >= bo.year_start  AND b.ts_local < bo.year_end  THEN b.good_read ELSE 0 END)\n        / NULLIF(SUM(CASE WHEN b.ts_local >= bo.year_start  AND b.ts_local < bo.year_end  THEN b.total_items ELSE 0 END), 0), 0) AS decimal(6,2)) AS year_good_read_pct,\n    COALESCE(SUM(CASE WHEN b.ts_local >= bo.month_start AND b.ts_local < bo.month_end THEN b.total_items ELSE 0 END), 0) AS month_total_parcels,\n    CAST(COALESCE(100.0 * SUM(CASE WHEN b.ts_local >= bo.month_start AND b.ts_local < bo.month_end THEN b.good_read ELSE 0 END)\n        / NULLIF(SUM(CASE WHEN b.ts_local >= bo.month_start AND b.ts_local < bo.month_end THEN b.total_items ELSE 0 END), 0), 0) AS decimal(6,2)) AS month_good_read_pct,\n    COALESCE(SUM(CASE WHEN b.ts_local >= bo.day_start   AND b.ts_local < bo.day_end   THEN b.total_items ELSE 0 END), 0) AS day_total_parcels,\n    CAST(COALESCE(100.0 * SUM(CASE WHEN b.ts_local >= bo.day_start   AND b.ts_local < bo.day_end   THEN b.good_read ELSE 0 END)\n        / NULLIF(SUM(CASE WHEN b.ts_local >= bo.day_start   AND b.ts_local < bo.day_end   THEN b.total_items ELSE 0 END), 0), 0) AS decimal(6,2)) AS day_good_read_pct\nFROM base b\nCROSS JOIN bounds bo;",
            "refId": "A"
          }
        ],
        "title": "",
