            "rawSql": "\nSELECT\n  CAST(DATEADD(HOUR,2,ds.ts_datetime) AS date)                             AS [Date],\n  d.customer                                                                AS [Customer],\n  SUM(ds.total_items)                                                       AS [Items]\nFROM dbo.device_statistics ds\nJOIN dbo.devices d ON d.id = ds.device_id\nWHERE ds.ts_datetime >= DATEADD(DAY,-7,GETUTCDATE())\nGROUP BY CAST(DATEADD(HOUR,2,ds.ts_datetime) AS date), d.customer\nORDER BY [Date];",
