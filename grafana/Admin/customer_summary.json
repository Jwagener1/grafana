        "targets": [
          {
            "datasource": {
              "type": "mssql",
              "uid": "PAAAEB8D7872B0C49"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "\nWITH latest_status AS (\n    SELECT x.device_id, x.status FROM (\n        SELECT ds.device_id, ds.status,\n               ROW_NUMBER() OVER (PARTITION BY ds.device_id ORDER BY ds.ts_datetime DESC) AS rn\n        FROM dbo.device_status ds\n    ) x WHERE x.rn = 1\n)\nSELECT\n  d.customer                                                               AS [Customer],\n  d.location + ' ' + d.machine_name                                       AS [Machine],\n  COALESCE(ls.status, 'offline')                                          AS [Status],\n  COALESCE(SUM(ds.total_items),0)                                         AS [Items],\n  CAST(COALESCE(100.0*SUM(ds.good_read)/NULLIF(SUM(ds.total_items),0),0)  AS decimal(5,1)) AS [Good Read %],\n  CAST(COALESCE(100.0*SUM(ds.no_read)/NULLIF(SUM(ds.total_items),0),0)    AS decimal(5,1)) AS [No Read %],\n  CAST(COALESCE(100.0*SUM(ds.no_dimension)/NULLIF(SUM(ds.total_items),0),0) AS decimal(5,1)) AS [No Dim %],\n  CAST(COALESCE(100.0*SUM(ds.no_weight)/NULLIF(SUM(ds.total_items),0),0)  AS decimal(5,1)) AS [No Weight %],\n  CAST(COALESCE(100.0*SUM(ds.hand_scanned)/NULLIF(SUM(ds.total_items),0),0) AS decimal(5,1)) AS [Hand Scan %],\n  COALESCE(SUM(ds.data_sent),0)                                           AS [Sent],\n  COALESCE(SUM(ds.not_sent),0)                                            AS [Not Sent]\nFROM dbo.devices d\nLEFT JOIN latest_status ls ON ls.device_id = d.id\nLEFT JOIN dbo.device_statistics ds\n    ON ds.device_id = d.id\n    AND CAST(DATEADD(HOUR,2,ds.ts_datetime) AS date) = CAST(DATEADD(HOUR,2,GETDATE()) AS date)\nGROUP BY d.customer, d.location, d.machine_name, ls.status\nORDER BY d.customer, d.location, d.machine_name;",
            "refId": "A"
          }
        ],
        "title": "All Machines \u2014 Today",
        "type": "table"
      }
