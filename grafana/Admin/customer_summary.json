            "rawQuery": true,
            "rawSql": "\nSELECT\n  d.customer AS [Customer],\n  COALESCE(SUM(ds.total_items),0) AS [Total Items],\n  COALESCE(SUM(ds.good_read),0)   AS [Good Reads],\n  COALESCE(SUM(ds.no_read),0)     AS [No Reads]\nFROM dbo.devices d\nLEFT JOIN dbo.device_statistics ds\n    ON ds.device_id = d.id\n    AND CAST(DATEADD(HOUR,2,ds.ts_datetime) AS date) = CAST(DATEADD(HOUR,2,GETDATE()) AS date)\nGROUP BY d.customer\nORDER BY d.customer;\n",
