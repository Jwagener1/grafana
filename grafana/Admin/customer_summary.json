            "format": "table",
            "rawQuery": true,
            "rawSql": "\nWITH last_seen AS (\n    SELECT device_id, MAX(ts_datetime) AS last_ts\n    FROM dbo.device_statistics\n    GROUP BY device_id\n),\ndevice_online AS (\n    SELECT d.customer,\n           COUNT(DISTINCT d.id) AS total_devices,\n           SUM(CASE WHEN ls.last_ts IS NOT NULL AND DATEDIFF(MINUTE, ls.last_ts, GETDATE()) < 60 THEN 1 ELSE 0 END) AS online_count\n    FROM dbo.devices d\n    LEFT JOIN last_seen ls ON ls.device_id = d.id\n    GROUP BY d.customer\n),\nstats_today AS (\n    SELECT d.customer,\n           COALESCE(SUM(ds.total_items),0)       AS items_today,\n           COALESCE(SUM(ds.good_read),0)          AS good_read,\n           COALESCE(SUM(ds.no_read),0)            AS no_read,\n           COALESCE(SUM(ds.no_dimension),0)       AS no_dimension,\n           COALESCE(SUM(ds.no_weight),0)          AS no_weight,\n           COALESCE(SUM(ds.hand_scanned),0)       AS hand_scanned,\n           COALESCE(SUM(ds.item_out_of_spec),0)   AS item_out_of_spec,\n           COALESCE(SUM(ds.more_than_1_item),0)   AS more_than_1_item,\n           COALESCE(SUM(ds.not_sent),0)           AS not_sent\n    FROM dbo.devices d\n    LEFT JOIN dbo.device_statistics ds\n        ON ds.device_id = d.id\n        AND CAST(DATEADD(HOUR,2,ds.ts_datetime) AS date) = CAST(DATEADD(HOUR,2,GETDATE()) AS date)\n    GROUP BY d.customer\n)\nSELECT\n    do.customer                                                                           AS [Customer],\n    do.total_devices                                                                      AS [Devices],\n    do.online_count                                                                       AS [Online],\n    do.total_devices - do.online_count                                                    AS [Offline],\n    st.items_today                                                                        AS [Items Today],\n    CAST(COALESCE(100.0*st.good_read       /NULLIF(st.items_today,0),0) AS decimal(5,1)) AS [Good Read %],\n    CAST(COALESCE(100.0*st.no_read         /NULLIF(st.items_today,0),0) AS decimal(5,1)) AS [No Read %],\n    CAST(COALESCE(100.0*st.no_dimension    /NULLIF(st.items_today,0),0) AS decimal(5,1)) AS [No Dim %],\n    CAST(COALESCE(100.0*st.no_weight       /NULLIF(st.items_today,0),0) AS decimal(5,1)) AS [No Weight %],\n    CAST(COALESCE(100.0*st.hand_scanned    /NULLIF(st.items_today,0),0) AS decimal(5,1)) AS [Hand Scan %],\n    CAST(COALESCE(100.0*st.item_out_of_spec/NULLIF(st.items_today,0),0) AS decimal(5,1)) AS [Out Spec %],\n    CAST(COALESCE(100.0*st.more_than_1_item/NULLIF(st.items_today,0),0) AS decimal(5,1)) AS [Multi-Item %],\n    st.not_sent                                                                           AS [Not Sent]\nFROM device_online do\nLEFT JOIN stats_today st ON st.customer = do.customer\nORDER BY do.customer;",
            "refId": "A"
          }
        ],
        "title": "Customer Performance Summary \u2014 Today",
        "type": "table"
      },
