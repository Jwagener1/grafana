        "targets": [
          {
            "datasource": {
              "type": "mssql",
              "uid": "PAAAEB8D7872B0C49"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT TOP 1\nCASE\n  WHEN os_version LIKE '%10.0.26200%' THEN 'Win 11 24H2+'\n  WHEN os_version LIKE '%10.0.26120%' THEN 'Win 11 24H2+'\n  WHEN os_version LIKE '%10.0.26100%' THEN 'Win 11 24H2'\n  WHEN os_version LIKE '%10.0.25398%' THEN 'Win 11 23H2'\n  WHEN os_version LIKE '%10.0.22631%' THEN 'Win 11 23H2'\n  WHEN os_version LIKE '%10.0.22621%' THEN 'Win 11 22H2'\n  WHEN os_version LIKE '%10.0.22000%' THEN 'Win 11 21H2'\n  WHEN os_version LIKE '%10.0.19045%' THEN 'Win 10 22H2'\n  WHEN os_version LIKE '%10.0.19044%' THEN 'Win 10 21H2'\n  WHEN os_version LIKE '%10.0.19043%' THEN 'Win 10 21H1'\n  WHEN os_version LIKE '%10.0.19042%' THEN 'Win 10 20H2'\n  WHEN os_version LIKE '%10.0.19041%' THEN 'Win 10 2004'\n  ELSE os_version\nEND AS [OS]\nFROM dbo.device_os_status\nWHERE device_id = ${machine}\nORDER BY ts_datetime DESC",
            "refId": "A"
          }
        ],
        "title": "OS Version",
        "type": "stat"
