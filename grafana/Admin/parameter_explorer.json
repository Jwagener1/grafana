      {
        "id": 3,
        "type": "timeseries",
        "title": "Total Items",
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "mssql",
          "uid": "PAAAEB8D7872B0C49"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 5,
              "spanNulls": true,
              "drawStyle": "line",
              "pointSize": 3,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "mssql",
              "uid": "PAAAEB8D7872B0C49"
            },
            "format": "time_series",
            "rawSql": "SELECT\n  s.ts_datetime AS time,\n  d.customer + ' \u203a ' + d.location + ' \u203a ' + d.machine_name AS metric,\n  s.total_items AS value\nFROM dbo.device_statistics s\nINNER JOIN dbo.devices d ON d.id = s.device_id\nWHERE s.device_id IN (\n  SELECT CAST(value AS INT) FROM STRING_SPLIT('${machines:raw}', ',') WHERE value != ''\n)\nAND $__timeFilter(s.ts_datetime)\nORDER BY s.ts_datetime",
            "refId": "A"
          }
        ]
      },
