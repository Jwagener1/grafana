        "datasource": {
          "type": "mssql",
          "uid": "PAAAEB8D7872B0C49"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": -2,
            "max": 102,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 5,
              "spanNulls": true,
              "drawStyle": "line",
              "pointSize": 3,
              "showPoints": "never"
            }
