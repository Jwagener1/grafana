          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "mssql",
              "uid": "PAAAEB8D7872B0C49"
            },
            "format": "time_series",
            "rawSql": "SELECT\n  s.ts_datetime AS time,\n  d.customer + ' \u203a ' + d.location + ' \u203a ' + d.machine_name AS metric,\n  CAST(CASE WHEN s.total_items > 0 THEN 100.0 * s.good_read / s.total_items ELSE NULL END AS DECIMAL(6,2)) AS value\nFROM dbo.device_statistics s\nINNER JOIN dbo.devices d ON d.id = s.device_id\nWHERE s.device_id IN (\n  SELECT CAST(value AS INT) FROM STRING_SPLIT('${machines:raw}', ',') WHERE value != ''\n)\nAND $__timeFilter(s.ts_datetime)\nORDER BY s.ts_datetime",
            "refId": "A"
          }
        ]
      },
