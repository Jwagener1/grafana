            "format": "time_series",
            "rawSql": "SELECT\n  s.ts_datetime AS time,\n  d.customer + ' \u203a ' + d.location + ' \u203a ' + d.machine_name + ' - Sent' AS metric,\n  s.data_sent AS value\nFROM dbo.device_statistics s\nINNER JOIN dbo.devices d ON d.id = s.device_id\nWHERE s.device_id IN (\n  SELECT CAST(value AS INT) FROM STRING_SPLIT('${machines:raw}', ',') WHERE value != ''\n)\nAND $__timeFilter(s.ts_datetime)\nUNION ALL\nSELECT\n  s.ts_datetime AS time,\n  d.customer + ' \u203a ' + d.location + ' \u203a ' + d.machine_name + ' - Not Sent' AS metric,\n  s.not_sent AS value\nFROM dbo.device_statistics s\nINNER JOIN dbo.devices d ON d.id = s.device_id\nWHERE s.device_id IN (\n  SELECT CAST(value AS INT) FROM STRING_SPLIT('${machines:raw}', ',') WHERE value != ''\n)\nAND $__timeFilter(s.ts_datetime)\nORDER BY time",
