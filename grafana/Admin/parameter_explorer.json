          },
          "definition": "SELECT customer + ' \u203a ' + location + ' \u203a ' + machine_name AS __text, id AS __value FROM dbo.devices ORDER BY customer, location, machine_name",
          "description": "Select one or more machines to plot",
          "includeAll": false,
          "label": "Machines",
          "multi": true,
          "name": "machines",
          "options": [],
          "query": "SELECT customer + ' \u203a ' + location + ' \u203a ' + machine_name AS __text, id AS __value FROM dbo.devices ORDER BY customer, location, machine_name",
